@page "/ResetPassword"
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Redefinir Senha</title>
    <link rel="stylesheet" href="/css/app.css" />
    <script>
        async function submitReset(event) {
            event.preventDefault();

            const token = new URLSearchParams(window.location.search).get("token");
            const newPassword = document.getElementById("new-password").value;
            const confirmPassword = document.getElementById("confirm-password").value;
            const result = document.getElementById("result-message");

            if (!token || !newPassword || !confirmPassword) {
                result.innerHTML = `<p class="message error">Preencha todos os campos.</p>`;
                return;
            }

            if (newPassword !== confirmPassword) {
                result.innerHTML = `<p class="message error">As senhas não coincidem.</p>`;
                return;
            }

            const request = {
                data: {
                    password: newPassword
                }
            };

            try {
                const response = await fetch(`/api/AccessManager/ResetPassword?token=${encodeURIComponent(token)}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(request)
                });

                if (response.ok) {
                    result.innerHTML = `<p class="message success">Senha redefinida com sucesso!</p>`;
                } else {
                    result.innerHTML = `<p class="message error">Erro ao redefinir a senha.</p>`;
                }
            } catch (error) {
                result.innerHTML = `<p class="message error">Erro ao processar a solicitação.</p>`;
            }
        }
    </script>
</head>
<body>
    <div class="reset-container">
        <img src="/images/logo.png" alt="Logo GoPlay" class="logo" />
        <h2 class="title">Redefinir Senha</h2>

        <div id="result-message"></div>

        <form onsubmit="submitReset(event)">
            <input id="new-password" type="password" placeholder="Nova Senha" />
            <input id="confirm-password" type="password" placeholder="Confirmar Senha" />

            <div class="requirements">
                <strong>Lembre-se, sua senha deve conter:</strong>
                <ul>
                    <li>Mínimo de 6 caracteres</li>
                    <li>Letras maiúsculas (A-Z)</li>
					<li>Letras minúsculas (a-z)</li>
                    <li>Números (0-9)</li>
                    <li>Caracteres especiais (!@@#$%^&*)</li>
                </ul>
            </div>

            <button type="submit">Redefinir</button>
        </form>
    </div>
</body>
</html>
